digraph Figure4 {
  graph [rankdir=TB, bgcolor="#F7F9FC", pad="0.3", nodesep="0.35", ranksep="0.36", splines=ortho, fontname="Arial", fontsize=24, labelloc=t, label="Figure 4. Save-before-publish transaction sequence"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=17, color="#B8C5D6", fillcolor="white", fontcolor="#1A2438", penwidth=1.5, margin="0.18,0.11", width=7.0];
  edge [fontname="Arial", fontsize=14, color="#5E6C84", fontcolor="#42526E", arrowsize=0.85, penwidth=1.5];

  S1 [label="1  Capture each required mutable collection once\nUse the same modified copies when commit(...) is called"];
  S2 [label="2  Apply the intended domain change\nMatching, reservation, completion, cancellation, or edit"];
  S3 [label="3  Build the candidate snapshot\nLifeFlowState(revision + 1, copied collections, logs)"];
  S4 [label="4  Validate the complete candidate\nDataValidator.validate(candidate, today)"];
  S5 [label="5  Persist the primary snapshot\nValidate temporary JSON, then atomically replace lifeflow.json"];
  S6 [label="6  Attempt backup refresh\nBackup failure records 'Data saved; backup needs retry' and does not undo the primary save"];
  S7 [label="7  Publish the in-memory snapshot\nstate = candidate.copy()"];
  S8 [label="8  Refresh the user interface in the caller\nUI callbacks run after the controller method succeeds", fillcolor="#EAF4FB", color="#35668A"];

  VF [label="Validation failure\nNo primary save\nPublished state and revision unchanged\nValidation exception is reported", width=3.6, fillcolor="#FFF0F0", color="#C62828", fontcolor="#8E1B1B"];
  PF [label="Primary persistence failure\nCandidate is not published\nPublished state and revision unchanged\nIOException is propagated", width=3.6, fillcolor="#FFF0F0", color="#C62828", fontcolor="#8E1B1B"];
  BW [label="Backup warning only\nPrimary JSON is already saved\nbackupCurrent = false\nProcessing continues to publish", width=3.6, fillcolor="#FFF7E6", color="#E07A00", fontcolor="#9A5200"];

  S1 -> S2 -> S3 -> S4 -> S5 -> S6 -> S7 -> S8;
  S4 -> VF [label="fails", color="#C62828", fontcolor="#C62828", constraint=false];
  S5 -> PF [label="fails", color="#C62828", fontcolor="#C62828", constraint=false];
  S6 -> BW [label="backup fails", color="#E07A00", fontcolor="#E07A00", constraint=false];

  {rank=same; S4; VF}
  {rank=same; S5; PF}
  {rank=same; S6; BW}
}
